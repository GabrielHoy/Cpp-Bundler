#include <Windows.h>
#include <winver.h>

1 ICON "@APP_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,@APP_VERSION_TWEAK@
 PRODUCTVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Tampered Reality\0"
      VALUE "FileDescription", "@APP_DESCRIPTION@\0"
      VALUE "FileVersion", "@APP_VERSION_STRING@\0"
      VALUE "InternalName", "@EXECUTABLE_NAME@\0"
      VALUE "OriginalFilename", "@EXECUTABLE_NAME@.exe\0"
      VALUE "ProductName", "@EXECUTABLE_NAME@\0"
      VALUE "ProductVersion", "@APP_PRODUCT_VERSION_STRING@\0"
      VALUE "LegalCopyright", "Copyright Tampered Reality @APP_COPYRIGHT_YEAR@\0"
      VALUE "Comments", "@APP_COMMENTS@\0"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END